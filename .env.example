# NASA FIRMS API area key: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# WMO SWIC/CAP does not expose one guaranteed global public API.
# Configure the approved CAP RSS/Atom feed URL supplied for the operational deployment.
WMO_CAP_FEED_URL=

# URL of the operational GeoJSON event feed produced by your GloFAS processing chain.
# Supported properties: title/name, issuedAt/datetime/date, returnPeriod/return_period, severity, url.
GLOFAS_EVENT_FEED_URL=

# Pre-approved ReliefWeb appname (mandatory since 2025-11-01):
# https://apidoc.reliefweb.int/parameters
RELIEFWEB_APPNAME=

# HTTPS URL of the CMA feed authorized for this deployment. The connector accepts
# CAP XML/RSS or GeoJSON with point/polygon geometry. Never put credentials in the
# URL; use a dedicated Authorization header or an authenticated upstream gateway.
CMA_EVENT_FEED_URL=
CMA_EVENT_FEED_AUTHORIZATION=

# CMA quality-controlled three-hour surface observations (SURF_CHN_MUL_HOR_3H).
# The official catalogue currently describes this product as D-2 / daily updated,
# so Tianxun uses it only as verification evidence and never as a standalone alert.
# Keep credentials server-side. Prefer an HTTPS gateway because the documented
# legacy endpoint uses plaintext HTTP with credentials in its query string.
CMA_SURFACE_API_URL=
CMA_SURFACE_USER_ID=
CMA_SURFACE_PASSWORD=
# Defaults: Wuxi 58354, Yixing 58346, Jiangyin 58351, Suzhou 58349 (1-30 IDs).
CMA_SURFACE_STATION_IDS=58354,58346,58351,58349
CMA_SURFACE_ELEMENTS=Station_Id_C,Year,Mon,Day,Hour,PRE_3h,WIN_S_Inst_Max,WIN_S_MAX,WIN_S_Avg_2mi,WEP_Now
CMA_SURFACE_TIME_ZONE=UTC
CMA_SURFACE_LOOKBACK_HOURS=168
# Set true only after accepting that the official legacy endpoint sends account
# credentials without transport encryption. Leave false when using HTTPS.
CMA_SURFACE_ALLOW_INSECURE_HTTP=false

# QWeather phase-1 hourly grid forecast. Create a free project, copy its unique
# API Host, and keep the API KEY on the server only. JWT is also supported and
# preferred for production when all three JWT fields are provided.
QWEATHER_API_HOST=
QWEATHER_API_KEY=
QWEATHER_PROJECT_ID=
QWEATHER_CREDENTIAL_ID=
# PEM value may use literal \n sequences in a single environment line.
QWEATHER_PRIVATE_KEY=
# Protect the free allowance against arbitrary public coordinate enumeration.
QWEATHER_DAILY_UNIQUE_LOCATION_LIMIT=120
# No key is required for the global MET Norway fallback. The provider requires
# an identifying User-Agent; keep a project/contact URL in this non-secret value.
MET_WEATHER_USER_AGENT=Tianxun-Disaster-Watch/0.1 github.com/STU-Jankin/tianxun-disaster-watch

# Optional satellite simulation/visibility service. POST requests receive a
# normalized task, AOI and UTC imaging window and must return { windows: [...] }.
SATELLITE_VISIBILITY_API_URL=

# Protect task and visibility APIs when the backend is accessed outside localhost.
# Generate independently for each deployment, for example: openssl rand -hex 32
TIANXUN_API_TOKEN=
# Optional least-privilege credentials for protected task and execution APIs.
# Keep them different from the admin/collector token above.
TIANXUN_OPERATOR_TOKEN=
TIANXUN_EXECUTOR_TOKEN=

# Optional trusted reverse-proxy credential for browser sessions. The proxy must
# strip client-supplied X-Tianxun-* headers, inject this value server-side and set
# X-Tianxun-User after authenticating the user. Use a separate 64-hex secret.
TIANXUN_TRUSTED_PROXY_SECRET=
