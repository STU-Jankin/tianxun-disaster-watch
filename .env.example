# NASA FIRMS API area key: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# WMO SWIC/CAP does not expose one guaranteed global public API.
# Configure the approved CAP RSS/Atom feed URL supplied for the operational deployment.
WMO_CAP_FEED_URL=

# URL of the operational GeoJSON event feed produced by your GloFAS processing chain.
# Supported properties: title/name, issuedAt/datetime/date, returnPeriod/return_period, severity, url.
GLOFAS_EVENT_FEED_URL=

# Pre-approved ReliefWeb appname (mandatory since 2025-11-01):
# https://apidoc.reliefweb.int/parameters
RELIEFWEB_APPNAME=

# Full URL of the CMA feed authorized for this deployment. The connector accepts
# CAP XML/RSS or GeoJSON with point/polygon geometry; keep credentials in the URL
# or in an upstream gateway managed by your organization, never in client code.
CMA_EVENT_FEED_URL=

# Optional satellite simulation/visibility service. POST requests receive a
# normalized task, AOI and UTC imaging window and must return { windows: [...] }.
SATELLITE_VISIBILITY_API_URL=

# Protect task and visibility APIs when the backend is accessed outside localhost.
# Generate independently for each deployment, for example: openssl rand -hex 32
TIANXUN_API_TOKEN=
