[Unit]
Description=Refresh and persist Tianxun disaster sources
After=network-online.target tianxun-engine.service
Wants=network-online.target tianxun-engine.service

[Service]
Type=oneshot
User=tianxun-engine
Group=tianxun-engine
WorkingDirectory=/opt/tianxun/current
EnvironmentFile=/etc/tianxun/engine.env
ExecStart=/usr/bin/node /opt/tianxun/current/vps/ingest.mjs
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/tianxun/engine
MemoryMax=256M
TasksMax=96
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
