[Unit]
Description=Tianxun global disaster collection engine
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=tianxun-engine
Group=tianxun-engine
WorkingDirectory=/opt/tianxun/current
EnvironmentFile=/etc/tianxun/engine.env
Environment=NODE_ENV=production
Environment="NODE_OPTIONS=--max-old-space-size=640 --disable-warning=ExperimentalWarning"
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/tianxun/engine
MemoryHigh=650M
MemoryMax=850M
TasksMax=256

[Install]
WantedBy=multi-user.target
