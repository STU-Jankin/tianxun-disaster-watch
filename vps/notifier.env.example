TIANXUN_ENGINE_URL=http://127.0.0.1:3000/api/events
TIANXUN_API_TOKEN=replace_with_the_same_engine_api_secret
TIANXUN_NOTIFY_DB=/var/lib/tianxun/notifier/notifier.sqlite
HERMES_WEBHOOK_URL=http://127.0.0.1:8644/webhooks/tianxun-alerts

# Must exactly match the secret used by `hermes webhook subscribe`.
HERMES_WEBHOOK_SECRET=replace_with_a_random_secret

# Notification policy. Existing events are baselined, not sent one by one.
MIN_NOTIFY_PRIORITY=65
CYCLONE_MOVE_ALERT_KM=150
SOURCE_FAILURE_THRESHOLD=3
MAX_DELIVERY_ATTEMPTS=8
MAX_ALERT_BATCH_SIZE=5
REQUEST_TIMEOUT_MS=45000
BOOTSTRAP_NOTIFY=true
NOTIFY_PHASE_TRANSITION=true
