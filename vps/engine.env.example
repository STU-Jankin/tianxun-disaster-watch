# Runtime database for the backend-only Node deployment.
TIANXUN_SQLITE_PATH=/var/lib/tianxun/engine/operational.sqlite
TIANXUN_API_TOKEN=replace_with_a_random_64_hex_secret
TIANXUN_VIEWER_TOKEN=replace_with_a_read_only_random_64_hex_secret
TIANXUN_OPERATOR_TOKEN=replace_with_a_different_random_64_hex_secret
TIANXUN_EXECUTOR_TOKEN=replace_with_another_random_64_hex_secret
TIANXUN_LOGIN_USERNAME=
TIANXUN_LOGIN_PASSWORD_HASH=
TIANXUN_LOGIN_ROLE=admin
TIANXUN_SESSION_TTL_MINUTES=480
TIANXUN_SESSION_IDLE_MINUTES=30

# Existing source credentials/configuration. Keep real values only on the VPS.
FIRMS_MAP_KEY=
WMO_CAP_FEED_URL=
GLOFAS_EVENT_FEED_URL=
RELIEFWEB_APPNAME=
CMA_EVENT_FEED_URL=
CMA_EVENT_FEED_AUTHORIZATION=
CMA_SURFACE_API_URL=
CMA_SURFACE_USER_ID=
CMA_SURFACE_PASSWORD=
CMA_SURFACE_STATION_IDS=58354,58346,58351,58349
CMA_SURFACE_ELEMENTS=Station_Id_C,Year,Mon,Day,Hour,PRE_3h,WIN_S_Inst_Max,WIN_S_MAX,WIN_S_Avg_2mi,WEP_Now
CMA_SURFACE_TIME_ZONE=UTC
CMA_SURFACE_LOOKBACK_HOURS=168
CMA_SURFACE_ALLOW_INSECURE_HTTP=false
QWEATHER_API_HOST=
QWEATHER_API_KEY=
QWEATHER_PROJECT_ID=
QWEATHER_CREDENTIAL_ID=
QWEATHER_PRIVATE_KEY=
QWEATHER_DAILY_UNIQUE_LOCATION_LIMIT=120
MET_WEATHER_USER_AGENT=Tianxun-Disaster-Watch/0.1 github.com/STU-Jankin/tianxun-disaster-watch
AMAP_WEB_SERVICE_KEY=
OVERPASS_PROFILE=public
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT=Tianxun-Disaster-Watch/0.1 github.com/STU-Jankin/tianxun-disaster-watch
# For a separately hosted China daily Overpass database:
# OVERPASS_PROFILE=china_daily
# OVERPASS_API_URL=https://osm-china.example.com/api/interpreter
# OVERPASS_MAX_AREA_KM2=50000
# OVERPASS_CHUNK_AREA_KM2=2500
# OVERPASS_CACHE_TTL_HOURS=26
# OVERPASS_STALE_IF_ERROR_HOURS=168
# OVERPASS_QUERY_TIMEOUT_SECONDS=45
# OVERPASS_ALLOW_PRIVATE_ENDPOINT=false
# Installed automatically by vps/scripts/install-osm-jiangsu.sh when the
# Jiangsu local OSM screening pilot is enabled:
JIANGSU_OSM_API_URL=
JIANGSU_OSM_API_TOKEN=
JIANGSU_OSM_MAX_AREA_KM2=120000
JIANGSU_OSM_TIMEOUT_SECONDS=15
JIANGSU_OSM_ALLOW_PRIVATE_ENDPOINT=false
SATELLITE_VISIBILITY_API_URL=
SATELLITE_VISIBILITY_CAPABILITIES_URL=
MISSION_OPTIMIZER_API_URL=
MISSION_SERVICE_TOKEN=
