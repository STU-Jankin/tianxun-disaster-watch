limit_req_zone $binary_remote_addr zone=tianxun_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=tianxun_api:10m rate=8r/s;
limit_req_zone $binary_remote_addr zone=tianxun_web:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=tianxun_conn:10m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name __PUBLIC_IP__;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://__PUBLIC_IP__:__HTTPS_PORT__$request_uri;
    }
}

server {
    listen __HTTPS_PORT__ ssl http2;
    listen [::]:__HTTPS_PORT__ ssl http2;
    server_name __PUBLIC_IP__;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/__PUBLIC_IP__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PUBLIC_IP__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TIANXUN_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 320k;
    limit_conn tianxun_conn 20;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    location = /api/health/live {
        limit_req zone=tianxun_api burst=3 nodelay;
        include /etc/nginx/snippets/tianxun-proxy-common.conf;
        proxy_pass http://127.0.0.1:3000;
    }

    location = /api/auth/login {
        client_max_body_size 8k;
        limit_req zone=tianxun_login burst=2 nodelay;
        include /etc/nginx/snippets/tianxun-proxy-common.conf;
        proxy_pass http://127.0.0.1:3000;
    }

    location ~ ^/api/auth/(?:logout|session)$ {
        limit_req zone=tianxun_api burst=4 nodelay;
        include /etc/nginx/snippets/tianxun-proxy-common.conf;
        proxy_pass http://127.0.0.1:3000;
    }

    location /api/ {
        limit_req zone=tianxun_api burst=12 nodelay;
        include /etc/nginx/snippets/tianxun-proxy-common.conf;
        proxy_pass http://127.0.0.1:3000;
    }

    location / {
        limit_req zone=tianxun_web burst=60 nodelay;
        include /etc/nginx/snippets/tianxun-proxy-common.conf;
        proxy_pass http://127.0.0.1:3000;
    }
}
